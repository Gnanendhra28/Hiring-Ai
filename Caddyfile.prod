{$PRODUCTION_DOMAIN:http://} {
    # Reverse proxy API requests to backend container
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Reverse proxy documentation endpoints to backend container
    handle /docs {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }
    handle /redoc {
        reverse_proxy backend:8000
    }
    handle /live {
        reverse_proxy backend:8000
    }
    handle /ready {
        reverse_proxy backend:8000
    }

    # Reverse proxy all other requests to Next.js frontend container
    handle {
        reverse_proxy frontend:3000
    }
}
