rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Helper function to check user ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check recruiter / admin role from token custom claims
    function isRecruiterOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'RECRUITER' ||
        request.auth.token.role == 'ORGANIZATION_ADMIN' ||
        request.auth.token.role == 'PLATFORM_ADMIN' ||
        request.auth.token.is_admin == true
      );
    }

    // ===============================================================
    // USER PROFILES
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isRecruiterOrAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'is_admin', 'is_platform_admin']);
      allow update: if isAuthenticated() && isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'is_admin', 'is_platform_admin']);
      allow delete: if false; // User deletion requires backend admin orchestration
    }

    // ===============================================================
    // ORGANIZATIONS & JOBS
    // ===============================================================
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isRecruiterOrAdmin();

      match /jobs/{jobId} {
        allow read: if true; // Public job listings
        allow write: if isRecruiterOrAdmin();
      }
    }

    // ===============================================================
    // INTERVIEWS & CONVERSATION TURNS
    // ===============================================================
    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && (
        resource.data.candidate_id == request.auth.uid ||
        isRecruiterOrAdmin()
      );
      allow create, update: if isAuthenticated() && isRecruiterOrAdmin();
      allow delete: if false;

      // Subcollection: Turns
      match /turns/{turnId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/interviews/$(interviewId)).data.candidate_id == request.auth.uid ||
          isRecruiterOrAdmin()
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/interviews/$(interviewId)).data.candidate_id == request.auth.uid ||
          isRecruiterOrAdmin()
        );
        allow update, delete: if false; // Turns are append-only audit records
      }

      // Subcollection: Scorecard
      match /scorecard/{scorecardId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/interviews/$(interviewId)).data.candidate_id == request.auth.uid ||
          isRecruiterOrAdmin()
        );
        allow write: if isRecruiterOrAdmin(); // Only evaluated and written by backend/recruiter
      }
    }

    // Default deny all other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
