# Production Terraform Variable Values Template
# Copy to terraform.tfvars before running terraform plan (DO NOT COMMIT REAL PASSWORDS TO GIT)

environment  = "production"
region       = "ap-south-2"
aws_profile  = "hiring-ai-production"
db_password  = "CHANGE_ME_SECURE_PRODUCTION_DB_PASSWORD_MIN_32_CHARS"
admin_cidr   = "127.0.0.1/32" # Restrict administrative SSH access
production_domain = "hiring.example.com"

# Cost Guardrails
enable_nat_gateway = false
enable_alb         = false
multi_az           = false
